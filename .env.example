# Frontend (Vite - must be VITE_ prefixed)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_WORKER_URL=https://tubescribe-backend-production.up.railway.app

# ── Worker (Railway) ─────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Transcription sources (any subset is fine; tried in this order)
DEEPGRAM_API_KEY=your-deepgram-key          # primary: real audio transcription (Nova-2)
SUPADATA_API_KEY=your-supadata-key          # fallback: caption API (bypasses YT bot detection)

# AI providers — tried in quality-priority order: Mistral → Cerebras →
# OpenRouter (free models) → Groq → Groq-fallback. Set the keys you have; the
# rest are skipped automatically.
MISTRAL_API_KEY=your-mistral-key            # api.mistral.ai (mistral-large-latest)
MISTRAL_MODEL=mistral-large-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1/chat/completions
CEREBRAS_API_KEY=your-cerebras-key          # gpt-oss-120b (1M tokens/day free)
CEREBRAS_MODEL=gpt-oss-120b
OPENROUTER_API_KEY=your-openrouter-key      # free models
OPENROUTER_MODEL=openai/gpt-oss-120b:free
GROQ_API_KEY=your-groq-key                   # 100K tokens/day free (fallback)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ── Stripe monetization (optional until set — checkout returns 503) ─────────
STRIPE_SECRET_KEY=sk_live_...                # Stripe REST API secret key
STRIPE_WEBHOOK_SECRET=whsec_...              # signing secret for /stripe/webhook
STRIPE_PRICE_MONTHLY=price_...               # defaults to the TubeScribe Pro $9/mo price
STRIPE_PRICE_YEARLY=price_...                # defaults to the TubeScribe Pro $79/yr price
STRIPE_PRICE_LIFETIME=price_...              # defaults to the TubeScribe Pro $199 one-time price
