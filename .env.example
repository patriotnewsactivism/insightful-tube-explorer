# Frontend (Vite - must be VITE_ prefixed)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# ── Worker (Railway) ─────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Transcription sources (any subset is fine; tried in this order)
DEEPGRAM_API_KEY=your-deepgram-key          # primary: real audio transcription (Nova-2)
SUPADATA_API_KEY=your-supadata-key          # fallback: caption API (bypasses YT bot detection)

# AI providers — tried in quality-priority order: Qwen → Mistral → Cerebras →
# OpenRouter → Poolside → Groq → Groq-fallback. Set the keys you have; the
# rest are skipped automatically.
QWENCLOUD_API_KEY=your-qwen-key              # Alibaba MaaS token-plan (ap-southeast-1)
QWEN_MODEL=qwen3.8-max-preview               # qwen3.7-max (stable) / qwen3.7-plus / qwen3.6-flash
QWEN_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1/chat/completions
MISTRAL_API_KEY=your-mistral-key            # api.mistral.ai (mistral-large-latest)
MISTRAL_MODEL=mistral-large-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1/chat/completions
CEREBRAS_API_KEY=your-cerebras-key          # gpt-oss-120b (quota exhausted → add credits)
CEREBRAS_MODEL=gpt-oss-120b
OPENROUTER_API_KEY=your-openrouter-key      # free models, Google login
OPENROUTER_MODEL=openai/gpt-oss-120b:free
POOLSIDE_API_KEY=your-poolside-key           # requires POOLSIDE_BASE_URL to enable
POOLSIDE_MODEL=poolside-1
POOLSIDE_BASE_URL=https://your-poolside-endpoint/v1/chat/completions
GROQ_API_KEY=your-groq-key                   # 100K tokens/day free (fallback)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
